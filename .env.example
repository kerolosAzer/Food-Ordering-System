# Copy this file to .env and fill in the real values before running docker-compose

DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<your-supabase-db-password>

USER_DATABASE_URL=jdbc:postgresql://<your-supabase-pooler-host>:6543/postgres?sslmode=require
RESTAURANT_DATABASE_URL=jdbc:postgresql://<your-supabase-pooler-host>:6543/postgres?sslmode=require
ORDER_DATABASE_URL=jdbc:postgresql://<your-supabase-pooler-host>:6543/postgres?sslmode=require
PAYMENT_DATABASE_URL=jdbc:postgresql://<your-supabase-pooler-host>:6543/postgres?sslmode=require
DELIVERY_DATABASE_URL=jdbc:postgresql://<your-supabase-pooler-host>:6543/postgres?sslmode=require

USER_DB_SCHEMA=user_service
RESTAURANT_DB_SCHEMA=restaurant_service
ORDER_DB_SCHEMA=order_service
PAYMENT_DB_SCHEMA=payment_service
DELIVERY_DB_SCHEMA=delivery_service

JWT_SECRET=<your-jwt-secret>
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/
